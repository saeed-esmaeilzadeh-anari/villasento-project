generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(cuid())
  phone              String         @unique
  fullName           String?
  email              String?
  nationalId         String?
  avatarUrl          String?
  role               String         @default("CUSTOMER")
  passwordHash       String?
  mustChangePassword Boolean        @default(false)
  themePrefs         String?
  isHostVerified     Boolean        @default(false)
  isBlocked          Boolean        @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  agentProfile       AgentProfile?
  articles           Article[]
  auditLogs          AuditLog[]
  bookings           Booking[]
  complaints         Complaint[]
  conversationsA     Conversation[] @relation("customerOf")
  conversationsH     Conversation[] @relation("hostOf")
  couponUsages       CouponUsage[]
  favorites          Favorite[]
  messages           Message[]
  notifications      Notification[]
  payouts            Payout[]
  agentProperties    Property[]     @relation("propertyAgent")
  properties         Property[]
  propertyViews      PropertyView[]
  reviews            Review[]
  assignedVisits     VisitRequest[] @relation("visitAssignee")
  visitRequests      VisitRequest[] @relation("visitRequester")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Province {
  id     String @id @default(cuid())
  name   String @unique
  cities City[]
}

model City {
  id         String     @id @default(cuid())
  name       String
  provinceId String
  areas      Area[]
  province   Province   @relation(fields: [provinceId], references: [id])
  properties Property[]

  @@unique([name, provinceId])
  @@index([provinceId])
}

model Area {
  id         String     @id @default(cuid())
  name       String
  cityId     String
  sort       Int        @default(0)
  city       City       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([cityId, name])
  @@index([cityId])
}

model Amenity {
  id         String            @id @default(cuid())
  key        String            @unique
  name       String
  icon       String            @default("Check")
  properties PropertyAmenity[]
}

model Property {
  id                String            @id @default(cuid())
  code              String            @unique
  hostId            String
  agentId           String?
  title             String
  type              String            @default("VILLA")
  transactionType   String            @default("RENT")
  description       String            @default("")
  cityId            String
  areaId            String?
  address           String            @default("")
  lat               Float?
  lng               Float?
  landArea          Int?
  buildArea         Int?
  bedrooms          Int               @default(2)
  bathrooms         Int               @default(1)
  floors            Int               @default(1)
  buildYear         Int?
  documentStatus    String            @default("MALIKI")
  amenitiesExtra    String            @default("")
  salePrice         Float?
  rahnAmount        Float?
  rentAmount        Float?
  negotiable        Boolean           @default(false)
  paymentTerms      String?
  videoUrl          String?
  tourUrl           String?
  contactName       String?
  contactPhone      String?
  contactPreference String            @default("BOTH")
  capacity          Int               @default(4)
  beds              Int               @default(3)
  basePrice         Int               @default(0)
  weekendPrice      Int               @default(0)
  cleaningFee       Int               @default(0)
  deposit           Int               @default(0)
  minNights         Int               @default(1)
  checkInTime       String            @default("14:00")
  checkOutTime      String            @default("12:00")
  rules             String            @default("")
  cancelPolicy      String            @default("MODERATE")
  instantBooking    Boolean           @default(false)
  status            String            @default("DRAFT")
  rejectionReason   String?
  publishedAt       DateTime?
  expiresAt         DateTime?
  isFeatured        Boolean           @default(false)
  featuredUntil     DateTime?
  ratingAvg         Float             @default(0)
  reviewCount       Int               @default(0)
  viewCount         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  videoPosterUrl    String?
  slug              String?           @unique
  bookings          Booking[]
  calendarDays      CalendarDay[]
  complaints        Complaint[]
  contactMessages   ContactMessage[]
  conversations     Conversation[]    @relation("conversationProperty")
  favorites         Favorite[]
  area              Area?             @relation(fields: [areaId], references: [id])
  city              City              @relation(fields: [cityId], references: [id])
  agent             User?             @relation("propertyAgent", fields: [agentId], references: [id])
  host              User              @relation(fields: [hostId], references: [id])
  amenities         PropertyAmenity[]
  images            PropertyImage[]
  views             PropertyView[]
  reviews           Review[]
  visitRequests     VisitRequest[]

  @@index([status, cityId])
  @@index([hostId])
  @@index([transactionType, status])
  @@index([isFeatured, status])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  url        String
  sort       Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model CalendarDay {
  id         String   @id @default(cuid())
  propertyId String
  date       String
  price      Int?
  isBlocked  Boolean  @default(false)
  note       String?
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model Booking {
  id               String         @id @default(cuid())
  code             String         @unique
  propertyId       String
  userId           String
  checkIn          String
  checkOut         String
  nights           Int
  adults           Int            @default(2)
  children         Int            @default(0)
  guestName        String
  guestPhone       String
  note             String?
  baseAmount       Int
  cleaningFee      Int            @default(0)
  discountAmount   Int            @default(0)
  penaltyAmount    Int            @default(0)
  totalAmount      Int
  commissionRate   Float          @default(0.1)
  commissionAmount Int            @default(0)
  hostPayout       Int            @default(0)
  status           String         @default("PENDING_PAYMENT")
  couponId         String?
  expiresAt        DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  coupon           Coupon?        @relation(fields: [couponId], references: [id])
  user             User           @relation(fields: [userId], references: [id])
  property         Property       @relation(fields: [propertyId], references: [id])
  events           BookingEvent[]
  complaints       Complaint[]
  payments         Payment[]
  review           Review?

  @@index([propertyId, checkIn, checkOut])
  @@index([userId])
  @@index([status])
}

model BookingEvent {
  id         String   @id @default(cuid())
  bookingId  String
  type       String
  fromStatus String?
  toStatus   String?
  actorId    String?
  message    String?
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String
  amount        Int
  status        String    @default("PENDING")
  gateway       String    @default("MOCK_GATEWAY")
  authority     String    @unique
  refId         String?
  cardMask      String?
  failureReason String?
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds       Refund[]

  @@index([bookingId])
}

model Refund {
  id          String    @id @default(cuid())
  paymentId   String
  bookingId   String
  amount      Int
  reason      String
  status      String    @default("PENDING")
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Coupon {
  id          String        @id @default(cuid())
  code        String        @unique
  title       String
  type        String        @default("PERCENT")
  value       Int
  maxDiscount Int?
  minAmount   Int?
  usageLimit  Int?
  usedCount   Int           @default(0)
  validFrom   DateTime      @default(now())
  validTo     DateTime
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  bookings    Booking[]
  usages      CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  bookingId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

model Payout {
  id          String    @id @default(cuid())
  hostId      String
  amount      Int
  itemsCount  Int       @default(0)
  periodLabel String
  status      String    @default("PENDING")
  note        String?
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  host        User      @relation(fields: [hostId], references: [id])

  @@index([hostId])
}

model Review {
  id          String   @id @default(cuid())
  propertyId  String
  userId      String
  bookingId   String   @unique
  rating      Int
  cleanliness Int      @default(5)
  accuracy    Int      @default(5)
  location    Int      @default(5)
  comment     String
  hostReply   String?
  status      String   @default("APPROVED")
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Favorite {
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
}

model Conversation {
  id            String    @id @default(cuid())
  propertyId    String
  hostId        String
  customerId    String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  customer      User      @relation("customerOf", fields: [customerId], references: [id])
  host          User      @relation("hostOf", fields: [hostId], references: [id])
  property      Property  @relation("conversationProperty", fields: [propertyId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([propertyId, customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  sender         User         @relation(fields: [senderId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @default("SYSTEM")
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Complaint {
  id         String    @id @default(cuid())
  userId     String
  type       String    @default("SUPPORT")
  propertyId String?
  bookingId  String?
  subject    String
  body       String
  status     String    @default("OPEN")
  adminReply String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  booking    Booking?  @relation(fields: [bookingId], references: [id])
  property   Property? @relation(fields: [propertyId], references: [id])
  user       User      @relation(fields: [userId], references: [id])
}

model CmsPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String
  category    String   @default("GENERAL")
  sort        Int      @default(0)
  isPublished Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorPhone String?
  action     String
  entity     String
  entityId   String?
  meta       String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entity, createdAt])
}

model SystemSetting {
  key   String @id
  value String
}

model PropertyView {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  ip         String?
  userAgent  String?
  day        String
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, day])
  @@index([day])
}

model VisitRequest {
  id           String              @id @default(cuid())
  code         String              @unique
  propertyId   String
  userId       String?
  name         String
  phone        String
  note         String?
  preferredAt  DateTime?
  status       String              @default("NEW")
  assignedToId String?
  adminNote    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  assignedTo   User?               @relation("visitAssignee", fields: [assignedToId], references: [id])
  user         User?               @relation("visitRequester", fields: [userId], references: [id])
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  events       VisitRequestEvent[]

  @@index([propertyId])
  @@index([status])
  @@index([userId])
}

model VisitRequestEvent {
  id             String       @id @default(cuid())
  visitRequestId String
  type           String
  fromStatus     String?
  toStatus       String?
  actorId        String?
  message        String?
  createdAt      DateTime     @default(now())
  visitRequest   VisitRequest @relation(fields: [visitRequestId], references: [id], onDelete: Cascade)

  @@index([visitRequestId])
}

model ContactMessage {
  id         String    @id @default(cuid())
  name       String
  phone      String
  email      String?
  subject    String?
  body       String
  propertyId String?
  status     String    @default("NEW")
  adminNote  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  property   Property? @relation(fields: [propertyId], references: [id])

  @@index([status])
}

model AgentProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  agencyName String?
  bio        String?
  photoUrl   String?
  licenseNo  String?
  phone2     String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model ArticleCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  sort     Int       @default(0)
  articles Article[]
}

model Article {
  id          String           @id @default(cuid())
  title       String
  slug        String           @unique
  excerpt     String           @default("")
  content     String
  coverUrl    String?
  categoryId  String?
  authorId    String?
  tags        String           @default("")
  viewCount   Int              @default(0)
  isPublished Boolean          @default(true)
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  author      User?            @relation(fields: [authorId], references: [id])
  category    ArticleCategory? @relation(fields: [categoryId], references: [id])

  @@index([isPublished])
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  position  String   @default("HOME_MID")
  sort      Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([position, isActive])
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  sort     Int     @default(0)
  isActive Boolean @default(true)
}
